# Copy to .env and adjust. Every value is optional — these are the defaults.
APP_NAME="LifeLine Blood Bank"
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
# Only needed if auto-detection of the URL prefix fails (e.g. "/bloodbank/public")
APP_BASE_PATH=

DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bloodbank
DB_USERNAME=postgres
DB_PASSWORD=postgres

LOW_STOCK_THRESHOLD=5
DONATION_INTERVAL_DAYS=56
SHELF_LIFE_DAYS=35
EXPIRY_WARNING_DAYS=7

# Days of supply and donor recall
SUPPLY_WINDOW_DAYS=30
SUPPLY_LOW_DAYS=7
SUPPLY_CRITICAL_DAYS=3
RECALL_COOLDOWN_DAYS=7

# Live updates: poll (works with php -S) or sse (needs Apache/Nginx + PHP-FPM)
REALTIME_MODE=poll
POLL_SECONDS=30
STREAM_SECONDS=25
